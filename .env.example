# Server-only PostgreSQL URL from Neon or Supabase. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required only for integration/concurrency tests. Use a separate disposable database.
INTEGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require

# Optional: agent lab (/agent) Live mode. Live mode is enabled only when both are set.
# LLM_API_KEY=
# INSTRUCTOR_PASSCODE=
# LLM_MODEL=claude-opus-5-5
# Optional: the public base URL the MCP server at /api/mcp calls (defaults to the request origin).
# AGENT_API_BASE_URL=https://api-test-eta-gilt.vercel.app
